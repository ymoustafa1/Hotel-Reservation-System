<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="app.controllers.RegisterController"
        styleClass="login-background">

    <HBox
            alignment="CENTER"
            maxWidth="1100"
            maxHeight="650"
            styleClass="login-card">


        <StackPane
                prefWidth="520"
                style="-fx-background-radius: 18 0 0 18;">

            <ImageView
                    fitWidth="520"
                    fitHeight="650"
                    preserveRatio="false">

                <image>
                    <Image url="@/hotel.jpg"/>
                </image>

            </ImageView>

            <Region
                    style="
            -fx-background-color:
            linear-gradient(
                to bottom right,
                rgba(15,23,42,0.82),
                rgba(30,58,95,0.75)
            );
            "/>

            <VBox
                    alignment="CENTER_LEFT"
                    spacing="18"
                    maxWidth="420">

                <Label
                        text="Create Your"
                        style="-fx-text-fill: white; -fx-font-size: 26;"/>

                <Label
                        text="Hotel Account"
                        style="-fx-text-fill: white; -fx-font-size: 54; -fx-font-weight: bold;"/>

                <Separator prefWidth="80"/>

                <Label
                        wrapText="true"
                        text="Register now to manage reservations, rooms, and hotel services efficiently."
                        style="-fx-text-fill: white; -fx-font-size: 18;"/>

            </VBox>

        </StackPane>


        <VBox
                alignment="CENTER"
                prefWidth="580">

            <padding>
                <Insets top="0" right="60" bottom="0" left="60"/>
            </padding>

            <ScrollPane
                    fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    pannable="true"
                    styleClass="auth-scroll">

                <content>

                    <VBox
                            alignment="CENTER"
                            spacing="14"
                            fillWidth="true">

                        <padding>
                            <Insets top="30" right="10" bottom="30" left="10"/>
                        </padding>

                        <Label
                                text="Register"
                                style="-fx-font-size: 32; -fx-font-weight: bold;"/>

                        <Label
                                text="Create a new account"
                                style="-fx-text-fill: #64748b; -fx-font-size: 15;"/>


                        <VBox
                                fx:id="errorBox"
                                visible="false"
                                managed="false"
                                spacing="6"
                                maxWidth="420"
                                styleClass="error-box">

                            <Label
                                    text="Registration Failed"
                                    styleClass="error-title"/>

                            <Label
                                    fx:id="errorLabel"
                                    wrapText="true"
                                    styleClass="error-message"/>

                        </VBox>


                        <VBox
                                alignment="CENTER_LEFT"
                                spacing="8"
                                maxWidth="420">

                            <Label
                                    text="Username"
                                    styleClass="field-label"/>

                            <TextField
                                    fx:id="usernameField"
                                    promptText="Enter your username"
                                    prefHeight="48"/>

                        </VBox>


                        <VBox
                                alignment="CENTER_LEFT"
                                spacing="8"
                                maxWidth="420">

                            <Label
                                    text="Password"
                                    styleClass="field-label"/>

                            <HBox
                                    alignment="CENTER_RIGHT"
                                    spacing="10">

                                <StackPane
                                        HBox.hgrow="ALWAYS">

                                    <PasswordField
                                            fx:id="passwordField"
                                            promptText="Enter your password"
                                            prefHeight="48"
                                            maxWidth="380"/>

                                    <TextField
                                            fx:id="visiblePasswordField"
                                            promptText="Enter your password"
                                            prefHeight="48"
                                            maxWidth="380"
                                            visible="false"
                                            managed="false"/>

                                </StackPane>

                                <Button
                                        fx:id="togglePasswordButton"
                                        text="👁"
                                        onAction="#togglePasswordVisibility"
                                        styleClass="eye-button"/>

                            </HBox>

                        </VBox>

                        <VBox
                                alignment="CENTER_LEFT"
                                spacing="8"
                                maxWidth="420">

                            <Label
                                    text="Date of Birth"
                                    styleClass="field-label"/>

                            <DatePicker
                                    fx:id="datePicker"
                                    prefHeight="48"
                                    maxWidth="420"/>

                        </VBox>

                        <VBox
                                alignment="CENTER_LEFT"
                                spacing="8"
                                maxWidth="420">

                            <Label
                                    text="Balance"
                                    styleClass="field-label"/>

                            <TextField
                                    fx:id="balanceField"
                                    promptText="Enter initial balance"
                                    prefHeight="48"/>

                        </VBox>

                        <VBox
                                alignment="CENTER_LEFT"
                                spacing="8"
                                maxWidth="420">

                            <Label
                                    text="Address"
                                    styleClass="field-label"/>

                            <TextField
                                    fx:id="addressField"
                                    promptText="Enter your address"
                                    prefHeight="48"/>

                        </VBox>

                        <VBox
                                alignment="CENTER_LEFT"
                                spacing="8"
                                maxWidth="420">

                            <Label
                                    text="Gender"
                                    styleClass="field-label"/>

                            <ComboBox
                                    fx:id="genderBox"
                                    prefHeight="48"
                                    promptText="Select gender"
                                    maxWidth="420"
                                    styleClass="combo-box"/>

                        </VBox>


                        <Button
                                text="Register"
                                prefWidth="420"
                                prefHeight="50"
                                styleClass="auth-button"
                                onAction="#handleCreateAccount"/>

                        <HBox
                                alignment="CENTER"
                                spacing="12"
                                maxWidth="420">

                            <Separator prefWidth="150"/>

                            <Label text="or"/>

                            <Separator prefWidth="150"/>

                        </HBox>

                        <!-- LOGIN LINK -->

                        <HBox
                                alignment="CENTER"
                                spacing="5">

                            <Label
                                    text="Already have an account?"
                                    style="-fx-text-fill: #64748b;"/>

                            <Hyperlink
                                    text="Login"
                                    onAction="#handleBackToLogin"/>

                        </HBox>

                    </VBox>

                </content>

            </ScrollPane>

        </VBox>

    </HBox>

</StackPane>