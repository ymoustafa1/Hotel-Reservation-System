<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="app.controllers.ForgotPasswordController"
        styleClass="login-background">

    <HBox
            alignment="CENTER"
            maxWidth="1100"
            maxHeight="650"
            styleClass="login-card">


        <StackPane
                prefWidth="520"
                style="-fx-background-radius: 18 0 0 18;">

            <ImageView
                    fitWidth="520"
                    fitHeight="650"
                    preserveRatio="false">

                <image>
                    <Image url="@/hotel.jpg"/>
                </image>

            </ImageView>

            <Region
                    style="
            -fx-background-color:
            linear-gradient(
                to bottom right,
                rgba(15,23,42,0.82),
                rgba(30,58,95,0.75)
            );
            "/>

            <VBox
                    alignment="CENTER_LEFT"
                    spacing="18"
                    maxWidth="420">

                <Label
                        text="Reset Your"
                        style="-fx-text-fill: white; -fx-font-size: 26;"/>

                <Label
                        text="Password"
                        style="-fx-text-fill: white; -fx-font-size: 54; -fx-font-weight: bold;"/>

                <Separator prefWidth="80"/>

                <Label
                        wrapText="true"
                        text="Recover access to your hotel management account securely."
                        style="-fx-text-fill: white; -fx-font-size: 18;"/>

            </VBox>

        </StackPane>


        <VBox
                alignment="CENTER"
                prefWidth="580">

            <padding>
                <Insets top="0" right="60" bottom="0" left="60"/>
            </padding>

            <VBox
                    alignment="CENTER"
                    spacing="16"
                    maxWidth="420">

                <Label
                        text="Forgot Password"
                        style="-fx-font-size: 32; -fx-font-weight: bold;"/>

                <Label
                        text="Enter your username"
                        style="-fx-text-fill: #64748b; -fx-font-size: 15;"/>


                <VBox
                        fx:id="errorBox"
                        visible="false"
                        managed="false"
                        spacing="6"
                        maxWidth="420"
                        styleClass="error-box">

                    <Label
                            text="Error"
                            styleClass="error-title"/>

                    <Label
                            fx:id="errorLabel"
                            wrapText="true"
                            styleClass="error-message"/>

                </VBox>


                <VBox
                        alignment="CENTER_LEFT"
                        spacing="8"
                        maxWidth="420">

                    <Label
                            text="Username"
                            styleClass="field-label"/>

                    <TextField
                            fx:id="usernameField"
                            promptText="Enter your username"
                            prefHeight="48"/>

                </VBox>


                <VBox
                        fx:id="passwordSection"
                        visible="false"
                        managed="false"
                        alignment="CENTER_LEFT"
                        spacing="14"
                        maxWidth="420">

                    <VBox
                            alignment="CENTER_LEFT"
                            spacing="8">

                        <Label
                                text="New Password"
                                styleClass="field-label"/>

                        <HBox
                                alignment="CENTER_RIGHT"
                                spacing="10">

                            <StackPane
                                    HBox.hgrow="ALWAYS">

                                <PasswordField
                                        fx:id="passwordField"
                                        promptText="Enter new password"
                                        prefHeight="48"
                                        maxWidth="380"/>

                                <TextField
                                        fx:id="visiblePasswordField"
                                        promptText="Enter new password"
                                        prefHeight="48"
                                        maxWidth="380"
                                        visible="false"
                                        managed="false"/>

                            </StackPane>

                            <Button
                                    fx:id="togglePasswordButton"
                                    text="👁"
                                    onAction="#togglePasswordVisibility"
                                    styleClass="eye-button"/>

                        </HBox>

                    </VBox>

                    <Button
                            text="Set Password"
                            prefWidth="420"
                            prefHeight="50"
                            styleClass="auth-button"
                            onAction="#handleSetPassword"/>

                </VBox>


                <Button
                        fx:id="findAccountButton"
                        text="Find Account"
                        prefWidth="420"
                        prefHeight="50"
                        styleClass="auth-button"
                        onAction="#handleFindUser"/>

                <Hyperlink
                        text="Back to Login"
                        onAction="#handleBackToLogin"/>

            </VBox>

        </VBox>

    </HBox>

</StackPane>